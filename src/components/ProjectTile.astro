---
interface Props {
  title: string;
  tagline: string;
  href?: string;
  featured?: boolean;
  image?: string;
  imagePosition?: string; // CSS object-position, default 'center'
  alwaysShowTagline?: boolean;
}
const { title, tagline, href, featured = false, image, imagePosition = 'center', alwaysShowTagline = false } = Astro.props;
const classes = [
  'tile',
  featured && 'tile--featured',
  !href && 'tile--static',
  image && 'tile--image',
  alwaysShowTagline && 'tile--tagline-visible',
].filter(Boolean) as string[];
---

{href ? (
  <a href={href} class:list={classes} data-umami-event="project_open" data-umami-event-project={title}>
    {image
      ? <img src={image} alt="" class="tile__photo" aria-hidden="true" loading="lazy" style={`object-position: ${imagePosition}`} />
      : <div class="tile__bg" aria-hidden="true"></div>
    }
    {image && <div class="tile__scrim" aria-hidden="true"></div>}
    <div class="tile__content">
      <div class="tile__text">
        <span class="tile__title">{title}</span>
        <span class="tile__tagline">{tagline}</span>
      </div>
      <span class="tile__arrow" aria-hidden="true">↗</span>
    </div>
  </a>
) : (
  <div class:list={classes}>
    {image
      ? <img src={image} alt="" class="tile__photo" aria-hidden="true" loading="lazy" style={`object-position: ${imagePosition}`} />
      : <div class="tile__bg" aria-hidden="true"></div>
    }
    {image && <div class="tile__scrim" aria-hidden="true"></div>}
    <div class="tile__content">
      <div class="tile__text">
        <span class="tile__title">{title}</span>
        <span class="tile__tagline">{tagline}</span>
      </div>
    </div>
  </div>
)}

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--grid-line);
    overflow: hidden;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .tile--static { cursor: default; }
  a.tile:hover  { border-color: var(--accent); }

  /* Engineering grid bg (no image) */
  .tile__bg {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        0deg,
        var(--grid-line) 0px, var(--grid-line) 1px,
        transparent 1px, transparent 40px
      ),
      repeating-linear-gradient(
        90deg,
        var(--grid-line) 0px, var(--grid-line) 1px,
        transparent 1px, transparent 40px
      );
    pointer-events: none;
  }

  /* Full-bleed cover photo */
  .tile__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s var(--ease-out);
  }

  a.tile--image:hover .tile__photo {
    transform: scale(1.03);
  }

  /* Gradient scrim so text is legible over photos */
  .tile__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(1, 1, 1, 0.80) 0%,
      rgba(1, 1, 1, 0.35) 40%,
      rgba(1, 1, 1, 0.10) 70%,
      transparent 100%
    );
    pointer-events: none;
  }

  .tile__content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex: 1;
    padding: 1.25rem;
    gap: 0.5rem;
  }

  .tile__text {
    display: flex;
    flex-direction: column;
    gap: 0; /* gap added via tagline margin-top on hover */
  }

  .tile__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--fw-bold);
    color: var(--text-100);
    line-height: var(--leading-snug);
  }

  .tile--featured .tile__title {
    font-size: var(--text-xl);
    font-weight: var(--fw-black);
  }

  .tile__tagline {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    /* Collapsed + invisible by default — title sits lower */
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    margin-top: 0;
    transition:
      opacity      0.15s var(--ease-out),
      max-height   0.25s var(--ease-out),
      margin-top   0.25s var(--ease-out);
  }

  /* On hover: tagline expands, title rises naturally */
  .tile:hover .tile__tagline {
    opacity: 1;
    max-height: 3em;
    margin-top: 0.3rem;
  }

  /* Always-visible tagline (no hover required) */
  .tile--tagline-visible .tile__tagline {
    opacity: 1;
    max-height: 3em;
    margin-top: 0.3rem;
    transition: none;
  }

  /* On image tiles the tagline reads better slightly brighter */
  .tile--image .tile__tagline {
    color: var(--text-50);
  }

  .tile__arrow {
    font-size: var(--text-md);
    color: var(--accent);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
    flex-shrink: 0;
    align-self: flex-end;
  }

  a.tile:hover .tile__arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* ── Mobile: no hover, so reveal taglines + arrow by default ── */
  @media (max-width: 768px) {
    .tile__tagline {
      opacity: 1;
      max-height: 3em;
      margin-top: 0.3rem;
      transition: none;
    }
    a.tile .tile__arrow {
      opacity: 1;
      transform: translate(0, 0);
    }
  }
</style>

<script>
  const CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';

  function scramble(el: HTMLElement, finalText: string): ReturnType<typeof setInterval> {
    const len = finalText.length;
    const FRAMES = 16; // ~480 ms at 30 ms per frame — short & snappy
    let frame = 0;

    // Start with all-random so text "arrives" rather than just appearing
    el.textContent = finalText
      .split('')
      .map(ch => (/[a-zA-Z0-9]/.test(ch)
        ? CHARS[Math.floor(Math.random() * CHARS.length)]
        : ch) ?? ch)
      .join('');

    return setInterval(() => {
      frame++;
      const resolved = Math.floor((frame / FRAMES) * len);
      el.textContent = finalText
        .split('')
        .map((ch, i) => {
          if (i < resolved) return ch;
          if (!/[a-zA-Z0-9]/.test(ch)) return ch;
          return CHARS[Math.floor(Math.random() * CHARS.length)] ?? ch;
        })
        .join('');
      if (frame >= FRAMES) el.textContent = finalText;
    }, 30);
  }

  function initScramble() {
    document.querySelectorAll<HTMLElement>('.tile').forEach(tile => {
      // Skip hub/static tiles and always-visible-tagline tiles
      if (tile.classList.contains('tile--tagline-visible')) return;
      if (tile.classList.contains('tile--static'))          return;
      // Skip tiles that already have listeners (re-navigation guard)
      if (tile.dataset.scrambleInit) return;
      tile.dataset.scrambleInit = '1';

      const tagEl = tile.querySelector<HTMLElement>('.tile__tagline');
      if (!tagEl) return;
      const original = tagEl.textContent ?? '';
      let timer: ReturnType<typeof setInterval> | null = null;

      tile.addEventListener('mouseenter', () => {
        if (timer) clearInterval(timer);
        timer = scramble(tagEl, original);
      });

      tile.addEventListener('mouseleave', () => {
        if (timer) { clearInterval(timer); timer = null; }
        tagEl.textContent = original;
      });
    });
  }

  // Run on initial load and every client-side navigation
  document.addEventListener('astro:page-load', initScramble);
</script>
