---
interface ReportCard {
  title: string;
  subtitle: string;
  date: string;
  href: string;
}

interface Props {
  reports: ReportCard[];
}

const { reports } = Astro.props;
---

<div class="reports-section">
  <p class="reports-label">Test Reports</p>
  <div class="reports-stack" role="list">
    {reports.map((report, i) => (
      <a
        href={report.href}
        class="report-card"
        target="_blank"
        rel="noopener noreferrer"
        role="listitem"
        aria-label={`Open ${report.title}`}
      >
        <div class="rc-header">
          <span class="rc-type">Test Report</span>
          <span class="rc-date">{report.date}</span>
        </div>
        <hr class="rc-rule" />
        <div class="rc-body">
          <p class="rc-title">{report.title}</p>
          <p class="rc-subtitle">{report.subtitle}</p>
        </div>
        <hr class="rc-rule" />
        <div class="rc-footer">
          <span class="rc-open">View Report ↗</span>
        </div>
      </a>
    ))}
  </div>
  <p class="reports-hint">Hover to select · Click to open</p>
</div>

<style>
  .reports-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .reports-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  /* Portrait / document proportions — explicit on both container AND card */
  .reports-stack {
    position: relative;
    width: 200px;
    height: 290px;
    flex-shrink: 0;
    overflow: visible;
  }

  .report-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    height: 290px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  /* Thrown resting state */
  .report-card:nth-child(1) { transform: rotate(-10deg) translate(-18px, 16px); z-index: 1; }
  .report-card:nth-child(2) { transform: rotate(  5deg) translate( 10px,  5px); z-index: 2; }
  .report-card:nth-child(3) { transform: rotate( -2deg) translate(  2px,  0px); z-index: 3; }

  /* Hover: just replace the top — no movement, instant z-index */
  .report-card:hover {
    z-index: 10;
    border-color: var(--accent);
  }

  /* ── Card interior ── */
  .rc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.625rem;
  }

  .rc-type {
    font-family: var(--font-label);
    font-size: var(--text-2xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  .rc-date {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-35);
  }

  .rc-rule {
    border: none;
    border-top: 1px solid var(--grid-line);
    margin: 0;
  }

  .rc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 0;
  }

  .rc-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--fw-semibold);
    color: var(--text-90);
    line-height: var(--leading-snug);
  }

  .rc-subtitle {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rc-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.625rem;
  }

  .rc-open {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.05em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .report-card:hover .rc-open { color: var(--accent); }

  .reports-hint {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .report-card { transition: border-color var(--dur-fast) var(--ease-out); }
    .report-card:nth-child(1),
    .report-card:nth-child(2),
    .report-card:nth-child(3) { transform: none; }
  }
</style>
