---
interface ReportCard {
  title: string;
  subtitle: string;
  date: string;
  href: string;
}

interface Props {
  reports: ReportCard[];
}

const { reports } = Astro.props;
---

<div class="reports-section">
  <p class="reports-label">Test Reports</p>
  <div class="reports-stack" role="list">
    {reports.map((report, i) => (
      <a
        href={report.href}
        class="report-card"
        style={`--card-index: ${i}`}
        target="_blank"
        rel="noopener noreferrer"
        role="listitem"
        aria-label={`Open ${report.title}`}
      >
        <div class="report-card__header">
          <span class="report-card__type">Test Report</span>
          <span class="report-card__date">{report.date}</span>
        </div>
        <p class="report-card__title">{report.title}</p>
        <p class="report-card__subtitle">{report.subtitle}</p>
        <span class="report-card__open">Open ↗</span>
      </a>
    ))}
  </div>
  <p class="reports-hint">Hover to browse · Click to open</p>
</div>

<style>
  .reports-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .reports-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  .reports-stack {
    position: relative;
    width: 320px;
    height: 300px;
    overflow: visible;
  }

  .report-card {
    position: absolute;
    inset: 0;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    transition: transform 0.35s var(--ease-out), z-index 0s, border-color var(--dur-fast) var(--ease-out);
  }

  /* Thrown resting state */
  .report-card:nth-child(1) { transform: rotate(-10deg) translate(-20px, 18px); z-index: 1; }
  .report-card:nth-child(2) { transform: rotate(  5deg) translate( 12px,  6px); z-index: 2; }
  .report-card:nth-child(3) { transform: rotate( -2deg) translate(  2px,  0px); z-index: 3; }

  /* Hover individual card — lifts to top, de-rotates toward viewer */
  .report-card:nth-child(1):hover {
    transform: rotate(-3deg) translate(-14px, 4px);
    z-index: 10;
    border-color: var(--accent);
  }
  .report-card:nth-child(2):hover {
    transform: rotate( 2deg) translate( 8px, -4px);
    z-index: 10;
    border-color: var(--accent);
  }
  .report-card:nth-child(3):hover {
    transform: rotate(-1deg) translate( 2px, -8px);
    z-index: 10;
    border-color: var(--accent);
  }

  .report-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .report-card__type {
    font-family: var(--font-label);
    font-size: var(--text-2xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  .report-card__date {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-35);
  }

  .report-card__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--fw-semibold);
    color: var(--text-100);
    line-height: var(--leading-snug);
    margin-top: auto;
  }

  .report-card__subtitle {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-50);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .report-card__open {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-35);
    letter-spacing: 0.06em;
    margin-top: auto;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .report-card:hover .report-card__open { color: var(--accent); }

  .reports-hint {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .report-card {
      transition: border-color var(--dur-fast) var(--ease-out);
      transform: none !important;
    }
  }
</style>
