---
interface ReportCard {
  title: string;
  subtitle: string;
  date: string;
  href: string;
}
interface Props {
  reports: ReportCard[];
}
const { reports } = Astro.props;
---

<div class="reports-component">
  <p class="reports-label">Test Reports</p>

  <div class="reports-deck">
    {reports.map((report, i) => (
      <a
        href={report.href}
        class="report-card"
        data-index={String(i)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open: ${report.title}`}
      >
        <div class="rc-header">
          <span class="rc-type">Test Report</span>
          <span class="rc-date">{report.date}</span>
        </div>
        <hr class="rc-rule" />
        <div class="rc-body">
          <p class="rc-title">{report.title}</p>
          <p class="rc-subtitle">{report.subtitle}</p>
        </div>
        <hr class="rc-rule" />
        <div class="rc-footer">
          <span class="rc-open">View Report ↗</span>
        </div>
      </a>
    ))}
  </div>

  <!-- Vast-style controls -->
  <div class="reports-controls">
    <button class="rctl-btn rctl-prev" type="button" aria-label="Previous report">←</button>
    <div class="rctl-indicators">
      {reports.map((_, i) => (
        <button
          class:list={['rctl-tick', { 'is-active': i === 0 }]}
          data-idx={String(i)}
          type="button"
          aria-label={`Report ${i + 1}`}
        ></button>
      ))}
    </div>
    <button class="rctl-btn rctl-next" type="button" aria-label="Next report">→</button>
  </div>
</div>

<script>
  function initDeck(root: Element) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.report-card'));
    const ticks = Array.from(root.querySelectorAll<HTMLElement>('.rctl-tick'));
    const n = cards.length;
    if (n === 0) return;

    let activeIdx = 0;
    let hovering = false;

    // Deck slot transforms — slot 0 is front, higher = further back
    const slotTransform = [
      'rotate(-1deg) translate(2px,   0px)',
      'rotate( 5deg) translate(16px,  9px)',
      'rotate(-8deg) translate(-18px, 15px)',
    ];
    const slotZ = [3, 2, 1];

    function applyDeck() {
      cards.forEach((card, i) => {
        const slot = ((i - activeIdx) % n + n) % n;
        const s = Math.min(slot, slotTransform.length - 1);
        card.style.transform = slotTransform[s]!;
        card.style.zIndex    = String(slotZ[s] ?? 1);
      });
      ticks.forEach((tick, i) => {
        tick.classList.toggle('is-active', i === activeIdx);
      });
    }

    // Hover: lift to front for reading
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        hovering = true;
        card.style.transform = 'rotate(-0.5deg) translate(0, -6px)';
        card.style.zIndex    = '10';
      });
      card.addEventListener('mouseleave', () => {
        hovering = false;
        applyDeck();
      });
    });

    // Prev / next shuffle
    root.querySelector('.rctl-prev')?.addEventListener('click', () => {
      activeIdx = ((activeIdx - 1) + n) % n;
      applyDeck();
    });
    root.querySelector('.rctl-next')?.addEventListener('click', () => {
      activeIdx = (activeIdx + 1) % n;
      applyDeck();
    });

    // Tick click
    ticks.forEach((tick, i) => {
      tick.addEventListener('click', () => {
        activeIdx = i;
        applyDeck();
      });
    });

    applyDeck();
  }

  document.querySelectorAll('.reports-component').forEach(initDeck);
</script>

<style>
  .reports-component {
    display: inline-flex;
    flex-direction: column;
    gap: 0;
  }

  .reports-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  /* ── Deck ── */
  .reports-deck {
    position: relative;
    width: 200px;
    height: 270px;
    overflow: visible;
  }

  .report-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    height: 270px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.4s var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .report-card:hover { border-color: var(--accent); }

  /* ── Card interior ── */
  .rc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.625rem;
  }

  .rc-type {
    font-family: var(--font-label);
    font-size: var(--text-2xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  .rc-date {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-35);
  }

  .rc-rule {
    border: none;
    border-top: 1px solid var(--grid-line);
    margin: 0;
  }

  .rc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 0;
  }

  .rc-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--fw-semibold);
    color: var(--text-90);
    line-height: var(--leading-snug);
  }

  .rc-subtitle {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rc-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.625rem;
  }

  .rc-open {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.05em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .report-card:hover .rc-open { color: var(--accent); }

  /* ── Controls ── */
  .reports-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .rctl-btn {
    background: none;
    border: 1px solid var(--hairline);
    color: var(--text-35);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    line-height: 1;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .rctl-btn:hover {
    border-color: var(--accent);
    color: var(--text-100);
  }

  /* Vast-style indicators: thin bars, active grows to square */
  .rctl-indicators {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .rctl-tick {
    width: 3px;
    height: 18px;
    background: var(--hairline);
    border: none;
    padding: 0;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      width  var(--dur-base) var(--ease-out),
      height var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out);
  }

  .rctl-tick.is-active {
    width: 13px;
    height: 13px;
    background: var(--accent);
  }

  .rctl-tick:hover:not(.is-active) {
    background: var(--text-35);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .report-card { transition: border-color var(--dur-fast) var(--ease-out); }
    .rctl-tick   { transition: none; }
  }
</style>
