---
interface ReportCard {
  title: string;
  subtitle: string;
  date: string;
  href: string;
}
interface Props {
  reports: ReportCard[];
}
const { reports } = Astro.props;
const n = reports.length;
const TICKS = 15;
---

<div class="reports-component">
  <p class="reports-label">Test Reports</p>

  <div class="reports-deck">
    {reports.map((report, i) => (
      <a
        href={report.href}
        class="report-card"
        data-index={String(i)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open: ${report.title}`}
      >
        <div class="rc-header">
          <span class="rc-type">Test Report</span>
          <span class="rc-date">{report.date}</span>
        </div>
        <hr class="rc-rule" />
        <div class="rc-body">
          <p class="rc-title">{report.title}</p>
          <p class="rc-subtitle">{report.subtitle}</p>
        </div>
        <hr class="rc-rule" />
        <div class="rc-footer">
          <span class="rc-open">View Report ↗</span>
        </div>
      </a>
    ))}
  </div>

  <div class="reports-controls">
    <button class="rctl-btn rctl-prev" type="button" aria-label="Previous report">←</button>

    <div class="slider-track">
      <div class="slider-ticks">
        {Array.from({ length: TICKS }, () => <div class="stk"></div>)}
      </div>
      <div
        class="slider-thumb"
        role="slider"
        tabindex="0"
        aria-valuemin="0"
        aria-valuemax={String(n - 1)}
        aria-valuenow="0"
        aria-label="Select report"
      ></div>
    </div>

    <button class="rctl-btn rctl-next" type="button" aria-label="Next report">→</button>
  </div>
</div>

<script>
  function initDeck(root: Element) {
    const cards  = Array.from(root.querySelectorAll<HTMLElement>('.report-card'));
    const track  = root.querySelector<HTMLElement>('.slider-track');
    const thumb  = root.querySelector<HTMLElement>('.slider-thumb');
    const ticks  = Array.from(root.querySelectorAll<HTMLElement>('.stk'));
    const n      = cards.length;
    if (n === 0 || !track || !thumb) return;

    let activeIdx = 0;

    const slotTransform = [
      'rotate(-1deg) translate( 2px,  0px)',
      'rotate( 5deg) translate(16px,  9px)',
      'rotate(-8deg) translate(-18px, 15px)',
    ];
    const slotZ = [3, 2, 1];

    // Left offset for thumb at a given report index
    function snapLeft(idx: number): number {
      const tw  = track.offsetWidth;
      const thw = thumb.offsetWidth;
      const eff = Math.max(0, tw - thw);
      return n > 1 ? (idx / (n - 1)) * eff : 0;
    }

    // Update tick heights based on thumb center x — ticks bloom around the square
    function updateTicks(thumbCenterX: number, animated: boolean) {
      const NT   = ticks.length;
      const tw   = track.offsetWidth;
      const step = tw / (NT - 1);
      const BASE = 10, PEAK = 26, SPREAD = step * 2.2;

      ticks.forEach((tick, i) => {
        const tickX = i * step;
        const dist  = Math.abs(tickX - thumbCenterX);
        const t     = Math.max(0, 1 - dist / SPREAD);
        const h     = Math.round(BASE + (PEAK - BASE) * t);
        tick.style.transition = animated ? 'height 0.25s var(--ease-out)' : 'none';
        tick.style.height     = h + 'px';
      });
    }

    function applyDeck(animated = true) {
      cards.forEach((card, i) => {
        const slot = ((i - activeIdx) % n + n) % n;
        const s    = Math.min(slot, slotTransform.length - 1);
        card.style.transform = slotTransform[s]!;
        card.style.zIndex    = String(slotZ[s] ?? 1);
      });
      const left = snapLeft(activeIdx);
      thumb.style.transition = animated ? 'left 0.35s var(--ease-out)' : 'none';
      thumb.style.left       = left + 'px';
      thumb.setAttribute('aria-valuenow', String(activeIdx));
      // Animate ticks to their bloom position after the thumb lands
      const thw = thumb.offsetWidth;
      updateTicks(left + thw / 2, animated);
    }

    // ── Drag ──────────────────────────────────────────────────────────
    let dragging   = false;
    let dragStartX = 0;
    let dragStartL = 0;

    thumb.addEventListener('mousedown', (e: MouseEvent) => {
      dragging   = true;
      dragStartX = e.clientX;
      dragStartL = parseFloat(thumb.style.left) || 0;
      thumb.style.transition = 'none'; // instant during drag
      e.preventDefault();
    });

    const onMove = (e: MouseEvent) => {
      if (!dragging) return;
      const tw  = track.offsetWidth;
      const thw = thumb.offsetWidth;
      const eff = Math.max(0, tw - thw);
      const dx  = e.clientX - dragStartX;
      const nl  = Math.max(0, Math.min(eff, dragStartL + dx));
      thumb.style.left = nl + 'px';
      updateTicks(nl + thw / 2, false); // instant tick bloom while dragging
    };

    const onUp = () => {
      if (!dragging) return;
      dragging  = false;
      const tw  = track.offsetWidth;
      const thw = thumb.offsetWidth;
      const eff = Math.max(1, tw - thw);
      const frac = (parseFloat(thumb.style.left) || 0) / eff;
      activeIdx = Math.round(frac * (n - 1));
      applyDeck(true); // smooth snap + animated tick bloom
    };

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup',   onUp);

    // ── Buttons ───────────────────────────────────────────────────────
    root.querySelector('.rctl-prev')?.addEventListener('click', () => {
      activeIdx = Math.max(0, activeIdx - 1);
      applyDeck(true);
    });
    root.querySelector('.rctl-next')?.addEventListener('click', () => {
      activeIdx = Math.min(n - 1, activeIdx + 1);
      applyDeck(true);
    });

    thumb.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft')  { activeIdx = Math.max(0, activeIdx - 1);     applyDeck(true); }
      if (e.key === 'ArrowRight') { activeIdx = Math.min(n - 1, activeIdx + 1); applyDeck(true); }
    });

    applyDeck(false); // initial position without animation
  }

  document.querySelectorAll('.reports-component').forEach(initDeck);
</script>

<style>
  .reports-component {
    display: flex;
    flex-direction: column;
    align-self: flex-start;
    width: 260px;
  }

  .reports-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  /* ── Deck ── */
  .reports-deck {
    position: relative;
    width: 200px;
    height: 270px;
    overflow: visible;
  }

  .report-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    height: 270px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.4s var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  /* Pre-JS thrown positions (activeIdx=0) */
  .report-card:nth-child(1) { transform: rotate(-1deg) translate( 2px,  0px); z-index: 3; }
  .report-card:nth-child(2) { transform: rotate( 5deg) translate(16px,  9px); z-index: 2; }
  .report-card:nth-child(3) { transform: rotate(-8deg) translate(-18px, 15px); z-index: 1; }

  .report-card:hover { border-color: var(--accent); }

  /* ── Card interior ── */
  .rc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.625rem;
  }

  .rc-type {
    font-family: var(--font-label);
    font-size: var(--text-2xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  .rc-date {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-35);
  }

  .rc-rule {
    border: none;
    border-top: 1px solid var(--grid-line);
    margin: 0;
  }

  .rc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 0;
  }

  .rc-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--fw-semibold);
    color: var(--text-90);
    line-height: var(--leading-snug);
  }

  .rc-subtitle {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rc-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.625rem;
  }

  .rc-open {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.05em;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .report-card:hover .rc-open { color: var(--accent); }

  /* ── Controls ── */
  .reports-controls {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.625rem;
    margin-top: 2.25rem;
    width: 100%;
  }

  .rctl-btn {
    background: none;
    border: 1px solid var(--hairline);
    color: var(--text-35);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 0.2rem 0.45rem;
    cursor: pointer;
    line-height: 1;
    flex-shrink: 0;
    transition: border-color var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }
  .rctl-btn:hover { border-color: var(--accent); color: var(--text-100); }

  /* ── Slider track ── */
  .slider-track {
    position: relative;
    flex: 1;
    height: 32px;
    display: flex;
    align-items: center;
  }

  .slider-ticks {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  /* Ticks: start at base height; JS adjusts dynamically */
  .stk {
    width: 2px;
    height: 10px; /* baseline — JS overrides */
    background: var(--hairline);
    flex-shrink: 0;
  }

  /* Draggable square */
  .slider-thumb {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 13px;
    height: 13px;
    background: var(--accent);
    cursor: grab;
    user-select: none;
    /* left + transition managed by JS */
  }

  .slider-thumb:active   { cursor: grabbing; }
  .slider-thumb:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .report-card   { transition: border-color var(--dur-fast) var(--ease-out); }
    .slider-thumb  { transition: none !important; }
    .stk           { transition: none !important; }
  }
</style>
