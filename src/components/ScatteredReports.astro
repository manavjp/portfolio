---
interface ReportCard {
  title: string;
  subtitle: string;
  date: string;
  href: string;
}
interface Props {
  reports: ReportCard[];
}
const { reports } = Astro.props;
const n = reports.length;
const TICKS = 15;
---

<div class="reports-component">
  <p class="reports-label">Test Reports</p>

  <div class="reports-deck">
    {reports.map((report, i) => (
      <a
        href={report.href}
        class="report-card"
        data-index={String(i)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open: ${report.title}`}
      >
        <div class="rc-header">
          <span class="rc-type">Test Report</span>
          <span class="rc-date">{report.date}</span>
        </div>
        <hr class="rc-rule" />
        <div class="rc-body">
          <p class="rc-title">{report.title}</p>
          <p class="rc-subtitle">{report.subtitle}</p>
        </div>
        <hr class="rc-rule" />
        <div class="rc-footer">
          <span class="rc-open">View Report ↗</span>
        </div>
      </a>
    ))}
  </div>

  <div class="reports-controls">
    <button class="rctl-btn rctl-prev" type="button" aria-label="Previous report">←</button>
    <div class="slider-track">
      <div class="slider-ticks">
        {Array.from({ length: TICKS }, () => <div class="stk"></div>)}
      </div>
      <!-- Visible square is 13×13; invisible hit area is 32×32 via ::before -->
      <div
        class="slider-thumb"
        role="slider"
        tabindex="0"
        aria-valuemin="0"
        aria-valuemax={String(n - 1)}
        aria-valuenow="0"
        aria-label="Select report"
      ></div>
    </div>
    <button class="rctl-btn rctl-next" type="button" aria-label="Next report">→</button>
  </div>
</div>

<script>
  function initDeck(root: Element) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.report-card'));
    const track = root.querySelector<HTMLElement>('.slider-track');
    const thumb = root.querySelector<HTMLElement>('.slider-thumb');
    const ticks = Array.from(root.querySelectorAll<HTMLElement>('.stk'));
    const n     = cards.length;
    if (n === 0 || !track || !thumb) return;

    let activeIdx = 0;

    // Slot definitions — used for both CSS initial state and JS interpolation
    const slots = [
      { r: -1, tx:  2, ty:  0, z: 3 }, // slot 0 = front
      { r:  5, tx: 16, ty:  9, z: 2 }, // slot 1 = middle
      { r: -8, tx:-18, ty: 15, z: 1 }, // slot 2 = back
    ];

    function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

    // Interpolate all cards smoothly between two integer deck states
    function updateCardsForFloat(floatIdx: number) {
      const clamped = Math.max(0, Math.min(n - 1, floatIdx));
      const lower   = Math.floor(clamped);
      const upper   = Math.min(n - 1, lower + 1);
      const t       = clamped - lower;

      cards.forEach((card, ci) => {
        const sA = Math.min(((ci - lower) % n + n) % n, slots.length - 1);
        const sB = Math.min(((ci - upper) % n + n) % n, slots.length - 1);
        const a  = slots[sA]!;
        const b  = slots[sB]!;
        card.style.transform = `rotate(${lerp(a.r, b.r, t)}deg) translate(${lerp(a.tx, b.tx, t)}px, ${lerp(a.ty, b.ty, t)}px)`;
        card.style.zIndex    = String(t < 0.5 ? a.z : b.z);
      });
    }

    function snapLeft(idx: number): number {
      const tw  = track.offsetWidth;
      const thw = thumb.offsetWidth;
      const eff = Math.max(0, tw - thw);
      return n > 1 ? (idx / (n - 1)) * eff : 0;
    }

    function updateTicks(thumbCenterX: number, animated: boolean) {
      const NT  = ticks.length;
      const tw  = track.offsetWidth;
      const step = tw / (NT - 1);
      const BASE = 10, PEAK = 26, SPREAD = step * 2.2;
      ticks.forEach((tick, i) => {
        const dist = Math.abs(i * step - thumbCenterX);
        const t    = Math.max(0, 1 - dist / SPREAD);
        tick.style.transition = animated ? 'height 0.25s var(--ease-out)' : 'none';
        tick.style.height     = Math.round(BASE + (PEAK - BASE) * t) + 'px';
      });
    }

    function applyDeck(animated = true) {
      if (animated) {
        cards.forEach(c => {
          c.style.transition = 'transform 0.4s var(--ease-out), border-color var(--dur-fast) var(--ease-out)';
        });
      }
      updateCardsForFloat(activeIdx);
      const left = snapLeft(activeIdx);
      thumb.style.transition = animated ? 'left 0.35s var(--ease-out)' : 'none';
      thumb.style.left       = left + 'px';
      thumb.setAttribute('aria-valuenow', String(activeIdx));
      updateTicks(left + thumb.offsetWidth / 2, animated);
    }

    // ── Drag ──────────────────────────────────────────────────────────
    let dragging   = false;
    let dragStartX = 0;
    let dragStartL = 0;

    thumb.addEventListener('mousedown', (e: MouseEvent) => {
      dragging   = true;
      dragStartX = e.clientX;
      dragStartL = parseFloat(thumb.style.left) || 0;
      thumb.style.transition = 'none';
      // Disable card transitions so shuffling is instant during drag
      cards.forEach(c => { c.style.transition = 'none'; });
      e.preventDefault();
    });

    const onMove = (e: MouseEvent) => {
      if (!dragging) return;
      const tw  = track.offsetWidth;
      const thw = thumb.offsetWidth;
      const eff = Math.max(0, tw - thw);
      const dx  = e.clientX - dragStartX;
      const nl  = Math.max(0, Math.min(eff, dragStartL + dx));
      thumb.style.left = nl + 'px';
      // Live shuffle: map drag position to a float report index
      const floatIdx = eff > 0 ? (nl / eff) * (n - 1) : 0;
      updateCardsForFloat(floatIdx);
      updateTicks(nl + thw / 2, false);
    };

    const onUp = () => {
      if (!dragging) return;
      dragging = false;
      const tw  = track.offsetWidth;
      const thw = thumb.offsetWidth;
      const eff = Math.max(1, tw - thw);
      const frac = (parseFloat(thumb.style.left) || 0) / eff;
      activeIdx = Math.round(frac * (n - 1));
      applyDeck(true);
    };

    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup',   onUp);

    // ── Buttons ───────────────────────────────────────────────────────
    root.querySelector('.rctl-prev')?.addEventListener('click', () => {
      activeIdx = Math.max(0, activeIdx - 1);
      applyDeck(true);
    });
    root.querySelector('.rctl-next')?.addEventListener('click', () => {
      activeIdx = Math.min(n - 1, activeIdx + 1);
      applyDeck(true);
    });

    thumb.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft')  { activeIdx = Math.max(0, activeIdx - 1);     applyDeck(true); }
      if (e.key === 'ArrowRight') { activeIdx = Math.min(n - 1, activeIdx + 1); applyDeck(true); }
    });

    applyDeck(false);
  }

  document.querySelectorAll('.reports-component').forEach(initDeck);
</script>

<style>
  .reports-component {
    display: flex;
    flex-direction: column;
    align-self: flex-start;
    width: 300px;
  }

  .reports-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  /* ── Deck (larger) ── */
  .reports-deck {
    position: relative;
    width: 220px;
    height: 300px;
    overflow: visible;
  }

  .report-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 220px;
    height: 300px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
    /* transition managed by JS */
  }

  /* Pre-JS thrown positions (activeIdx=0) */
  .report-card:nth-child(1) { transform: rotate(-1deg) translate( 2px,  0px); z-index: 3; }
  .report-card:nth-child(2) { transform: rotate( 5deg) translate(16px,  9px); z-index: 2; }
  .report-card:nth-child(3) { transform: rotate(-8deg) translate(-18px, 15px); z-index: 1; }

  .report-card:hover { border-color: var(--accent); }

  /* ── Card interior ── */
  .rc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .rc-type {
    font-family: var(--font-label);
    font-size: var(--text-2xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }

  .rc-date {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-35);
  }

  .rc-rule {
    border: none;
    border-top: 1px solid var(--grid-line);
    margin: 0;
  }

  .rc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.625rem;
    padding: 1rem 0;
  }

  .rc-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--fw-semibold);
    color: var(--text-90);
    line-height: var(--leading-snug);
  }

  .rc-subtitle {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .rc-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.75rem;
  }

  .rc-open {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.05em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .report-card:hover .rc-open { color: var(--accent); }

  /* ── Controls ── */
  .reports-controls {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.625rem;
    margin-top: 2.5rem;
    width: 100%;
  }

  .rctl-btn {
    background: none;
    border: 1px solid var(--hairline);
    color: var(--text-35);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 0.2rem 0.45rem;
    cursor: pointer;
    line-height: 1;
    flex-shrink: 0;
    transition: border-color var(--dur-fast) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
  }
  .rctl-btn:hover { border-color: var(--accent); color: var(--text-100); }

  /* ── Slider ── */
  .slider-track {
    position: relative;
    flex: 1;
    height: 34px;
    display: flex;
    align-items: center;
  }

  .slider-ticks {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .stk {
    width: 2px;
    height: 10px;
    background: var(--hairline);
    flex-shrink: 0;
    /* height managed by JS */
  }

  /* Visible square: 13×13 */
  .slider-thumb {
    position: absolute;
    top: 50%;
    left: 0;
    width: 13px;
    height: 13px;
    transform: translateY(-50%);
    background: var(--accent);
    cursor: grab;
    user-select: none;
  }

  /* Invisible hit-area extension — 20px larger on each side */
  .slider-thumb::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
  }

  .slider-thumb:active       { cursor: grabbing; }
  .slider-thumb:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }

  @media (prefers-reduced-motion: reduce) {
    .report-card,
    .slider-thumb { transition: none !important; }
    .stk          { transition: none !important; }
  }
</style>
