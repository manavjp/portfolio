---
import Layout from '../layouts/Layout.astro';
import { RESUME_URL } from '../config';
---

<Layout title="Contact">
  <div class="page-padded">

    <div class="page-header">
      <span class="page-label">// 005</span>
      <h1 class="page-title">Contact</h1>
    </div>

    <div class="contact-list">

      <button
        type="button"
        class="contact-item contact-item--copy"
        data-copy="manavjpatel@g.ucla.edu"
        data-umami-event="email_copy"
      >
        <span class="contact-item__label">Email</span>
        <span class="contact-item__value">
          manavjpatel@ucla.edu
          <span class="contact-item__icon" aria-hidden="true">
            <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </span>
        </span>
      </button>

      <a
        href="https://www.linkedin.com/in/manavjp/"
        class="contact-item"
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="linkedin_click"
      >
        <span class="contact-item__label">LinkedIn</span>
        <span class="contact-item__value">
          linkedin.com/in/manavjp
          <span class="contact-item__arrow" aria-hidden="true">↗</span>
        </span>
      </a>

      <a
        href={RESUME_URL}
        class="contact-item"
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="resume_click"
        data-umami-event-location="contact"
      >
        <span class="contact-item__label">Resume</span>
        <span class="contact-item__value">
          drive.google.com
          <span class="contact-item__arrow" aria-hidden="true">↗</span>
        </span>
      </a>

    </div>

  </div>
</Layout>

<script>
  // Email "link" copies the real address to the clipboard instead of opening
  // a mail client; a check briefly replaces the copy icon to confirm.
  async function copyText(text: string): Promise<boolean> {
    // Preferred path: async Clipboard API (secure contexts).
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch {
      /* fall through to the legacy path below */
    }
    // Legacy fallback: hidden textarea + execCommand (older / insecure contexts).
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch {
      return false;
    }
  }

  function initEmailCopy() {
    document.querySelectorAll<HTMLElement>('.contact-item--copy').forEach(btn => {
      if (btn.dataset.copyInit) return;
      btn.dataset.copyInit = '1';

      let timer: ReturnType<typeof setTimeout> | null = null;

      btn.addEventListener('click', async () => {
        const ok = await copyText(btn.dataset.copy ?? '');
        if (!ok) return;
        btn.classList.add('is-copied');
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => btn.classList.remove('is-copied'), 1400);
      });
    });
  }

  document.addEventListener('astro:page-load', initEmailCopy);
</script>

<style>
  .page-header { margin-bottom: 3rem; }

  .page-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--fw-black);
    color: var(--text-100);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .page-header { margin-bottom: 2rem; }
    .page-title  { font-size: clamp(2.5rem, 12vw, 3rem); }
  }

  /* ── Contact list ── */
  .contact-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--grid-line);
  }

  .contact-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    align-items: baseline;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--grid-line);
    color: var(--text-70);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact-item:hover {
    color: var(--text-100);
  }

  .contact-item__label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact-item:hover .contact-item__label {
    color: var(--text-50);
  }

  .contact-item__value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .contact-item__arrow {
    font-size: 0.7em;
    color: var(--text-35);
    transition: color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
    display: inline-block;
  }

  .contact-item:hover .contact-item__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* ── Email copy button — shares contact-item styling, reset button chrome ── */
  button.contact-item {
    width: 100%;
    border-top: none;
    border-left: none;
    border-right: none;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .contact-item__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-35);
    transition: color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
    transform-origin: center;
  }

  .contact-item__icon svg {
    width: 0.7em;
    height: 0.7em;
    display: block;
  }

  /* Stack the check over the copy glyph so the swap doesn't shift layout. */
  .contact-item__icon .icon-check {
    position: absolute;
    inset: 0;
    margin: auto;
    opacity: 0;
  }

  /* Hover: grow + accent — same feel/tokens as the ↗ arrows. */
  .contact-item:hover .contact-item__icon {
    color: var(--accent);
    transform: scale(1.18);
  }

  /* Copied confirmation: swap to a check, hold accent briefly. */
  .contact-item--copy.is-copied .contact-item__icon { color: var(--accent); }
  .contact-item--copy.is-copied .icon-copy  { opacity: 0; }
  .contact-item--copy.is-copied .icon-check { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .contact-item:hover .contact-item__icon { transform: none; }
  }

  @media (max-width: 600px) {
    .contact-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
