---
import Layout from '../layouts/Layout.astro';
import { RESUME_URL } from '../config';
---

<Layout title="Contact">
  <div class="page-padded">

    <div class="page-header">
      <span class="page-label">// 005</span>
      <h1 class="page-title">Contact</h1>
    </div>

    <div class="contact-list">

      <a href="mailto:manavjpatel@g.ucla.edu" class="contact-item" data-umami-event="email_click">
        <span class="contact-item__label">Email</span>
        <span class="contact-item__value">
          manavjpatel@ucla.edu
          <span class="contact-item__arrow" aria-hidden="true">↗</span>
        </span>
      </a>

      <a
        href="https://www.linkedin.com/in/manavjp/"
        class="contact-item"
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="linkedin_click"
      >
        <span class="contact-item__label">LinkedIn</span>
        <span class="contact-item__value">
          linkedin.com/in/manavjp
          <span class="contact-item__arrow" aria-hidden="true">↗</span>
        </span>
      </a>

      <a
        href="https://app.reclaim.ai/m/manavp"
        class="contact-item"
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="meeting_click"
      >
        <span class="contact-item__label">Meeting</span>
        <span class="contact-item__value">
          app.reclaim.ai/m/manavp
          <span class="contact-item__arrow" aria-hidden="true">↗</span>
        </span>
      </a>

      <a
        href={RESUME_URL}
        class="contact-item"
        target="_blank"
        rel="noopener noreferrer"
        data-umami-event="resume_click"
        data-umami-event-location="contact"
      >
        <span class="contact-item__label">Resume</span>
        <span class="contact-item__value">
          drive.google.com
          <span class="contact-item__arrow" aria-hidden="true">↗</span>
        </span>
      </a>

    </div>

  </div>
</Layout>

<style>
  .page-header { margin-bottom: 3rem; }

  .page-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--fw-black);
    color: var(--text-100);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  /* ── Contact list ── */
  .contact-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--grid-line);
  }

  .contact-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    align-items: baseline;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--grid-line);
    color: var(--text-70);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact-item:hover {
    color: var(--text-100);
  }

  .contact-item__label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact-item:hover .contact-item__label {
    color: var(--text-50);
  }

  .contact-item__value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .contact-item__arrow {
    font-size: 0.7em;
    color: var(--text-35);
    transition: color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
    display: inline-block;
  }

  .contact-item:hover .contact-item__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 600px) {
    .contact-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
