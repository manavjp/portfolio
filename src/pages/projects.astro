---
import Layout from '../layouts/Layout.astro';
import ProjectTile from '../components/ProjectTile.astro';
import ITARTile from '../components/ITARTile.astro';
---

<Layout title="Projects">
  <div class="page-padded projects-page">

    <div class="section-header">
      <span class="section-label">UCLA Rocket Project</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-hub">
        <ProjectTile
          title="UCLA Rocket Project"
          tagline="5 projects · Propulsion · Structures · Data"
          featured={true}
          alwaysShowTagline={true}
          image="/assets/projects/rocket-project/rocketproject_cover.JPG"
        />
      </div>
      <div class="t-hts">
        <ProjectTile
          title="Horizontal Propulsion Test Stand"
          tagline="Isolating 5,635 lbf-s onto linear rails"
          href="/projects/horizontal-propulsion-test-stand"
          image="/assets/projects/horizontal-propulsion-test-stand/hts_cover.png"
        />
      </div>
      <div class="t-inj">
        <ProjectTile
          title="N2O Two-Phase Flow Model"
          tagline="Two-phase N₂O model, 35% → 10.3% error"
          href="/projects/injector-orifice-sizing"
        />
      </div>
      <div class="t-vstand">
        <ProjectTile
          title="Vertical Tank Mount"
          tagline="Structural validation in Ansys Mechanical"
          href="/projects/vertical-test-stand"
        />
      </div>
      <div class="t-wflows">
        <ProjectTile
          title="Injector Water Flows"
          tagline="Cold-flow characterization before hot fire"
          href="/projects/injector-water-flows"
        />
      </div>
      <div class="t-data">
        <ProjectTile
          title="Propulsion Data Analysis"
          tagline="20+ pages of hydro, cold-flow & static-fire reports"
          href="/projects/propulsion-data-analysis"
        />
      </div>
    </div>

    <div class="section-header">
      <span class="section-label">Reynolds Systems</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-rs">
        <ITARTile title="Production Fixtures"       tagline="Engineering design & fabrication"   />
      </div>
      <div class="t-rs">
        <ITARTile title="Additive Manufacturing"    tagline="Design for additive manufacturing"  />
      </div>
      <div class="t-rs">
        <ITARTile title="Exploding Foil Initiator"  tagline="Precision initiation engineering"   />
      </div>
      <div class="t-rs">
        <ITARTile title="Precision Initiating Couplers" tagline="Ordnance interface engineering" />
      </div>
    </div>

    <div class="section-header">
      <span class="section-label">AdvancingX</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-sub">
        <ProjectTile
          title="EVA Training Submersible"
          tagline="16-ft neutrally buoyant open-frame EVA trainer"
          href="/projects/submersible-v3"
          image="/assets/projects/advancingx/SubX_cover.png"
          imagePosition="right 25%"
        />
      </div>
    </div>

    <div class="section-header">
      <span class="section-label">Mechatronics & Controls Lab</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-uav">
        <ProjectTile
          title="UAV Research"
          tagline="DfAM gimbal joint, 6-DoF singularity elimination"
          href="/projects/uav-gimbal-joint"
          image="/assets/projects/maclab/drone_cover.png"
        />
      </div>
    </div>

    <div class="section-header">
      <span class="section-label">Standalone</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-e1rk">
        <ProjectTile
          title="3D Printed Model Rocket"
          tagline="E1RK · FDM sounding rocket — OpenRocket + SolidWorks"
          href="/projects/3d-printed-rocket"
          image="/assets/projects/3dpr/3DPR_cover.JPG"
        />
      </div>
      <div class="t-e1rk">
        <ProjectTile
          title="Group High Powered Rocket"
          tagline="E1RK · Fiberglass airframe, 3D-printed nose cone & boat tail"
          href="/projects/group-high-powered-rocket"
          image="/assets/projects/gmpr/gmpr_cover.png"
        />
      </div>
      <div class="t-obst">
        <ProjectTile
          title="Autonomous Obstacle Avoidance Vehicle"
          tagline="Ultrasonic Sensing · Arduino IDE · Embedded Systems"
          href="/projects/obstacle-avoidance-robot"
          image="/assets/projects/arduino_car/arduniocar_cover.jpg"
        />
      </div>
      <div class="t-obs">
        <ProjectTile
          title="Observatory Research & Service"
          tagline="Astrometry · Photometry · Education"
          href="/projects/taylor-observatory"
          image="/assets/projects/observatory/foto_cover.jpg"
          imagePosition="top"
        />
      </div>
    </div>

  </div>
</Layout>

<style>
  .projects-page { padding-bottom: 4rem; }

  .section-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2.5rem 0 1.25rem;
  }
  .section-header:first-child { margin-top: 0; }

  .section-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    border: none;
    border-top: 1px solid var(--grid-line);
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--col-gap);
  }

  /* Rocket cluster */
  .t-hub    { grid-column: span 7; min-height: 300px; }
  .t-hts    { grid-column: span 5; min-height: 300px; }
  .t-inj    { grid-column: span 4; min-height: 180px; }
  .t-vstand { grid-column: span 4; min-height: 180px; }
  .t-wflows { grid-column: span 4; min-height: 180px; }
  .t-data   { grid-column: span 12; min-height: 120px; }

  /* Reynolds Systems — 4 equal tiles */
  .t-rs { grid-column: span 3; min-height: 200px; }

  /* Single-org sections (AdvancingX, MacLab) — wider tiles */
  .t-sub  { grid-column: span 8; min-height: 260px; }
  .t-uav  { grid-column: span 8; min-height: 260px; }

  /* E1RK — two equal tiles */
  .t-e1rk { grid-column: span 6; min-height: 220px; }

  /* Standalone */
  .t-obst { grid-column: span 6; min-height: 220px; }
  .t-obs  { grid-column: span 6; min-height: 220px; }

  @media (max-width: 900px) {
    .t-hub, .t-hts,
    .t-inj, .t-vstand, .t-wflows { grid-column: span 6; }
    .t-rs                         { grid-column: span 6; }
    .t-sub, .t-uav               { grid-column: span 10; }
    .t-e1rk, .t-obst, .t-obs    { grid-column: span 6; }
  }

  @media (max-width: 600px) {
    .t-hub, .t-hts,
    .t-inj, .t-vstand, .t-wflows,
    .t-rs,
    .t-sub, .t-uav,
    .t-e1rk,
    .t-obst, .t-obs { grid-column: span 12; }
  }
</style>
