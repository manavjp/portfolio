---
import Layout from '../layouts/Layout.astro';
import ProjectTile from '../components/ProjectTile.astro';
import ITARTile from '../components/ITARTile.astro';
---

<Layout title="Projects">
  <div class="page-padded projects-page">

    <div class="page-header">
      <span class="page-label">// 002</span>
      <h1 class="page-title">Projects</h1>
    </div>

    <div class="section-header">
      <span class="section-label">UCLA Rocket Project</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-hub">
        <ProjectTile
          title="UCLA Rocket Project"
          tagline="4 projects · Propulsion · Structures · Analysis"
          featured={true}
          alwaysShowTagline={true}
          image="/assets/projects/rocket-project/rocketproject_cover.JPG"
        />
      </div>
      <div class="t-hts">
        <ProjectTile
          title="Horizontal Test Stand"
          tagline="Isolating 600 lbf thrust for static fires"
          href="/projects/horizontal-propulsion-test-stand"
          image="/assets/projects/horizontal-propulsion-test-stand/hts_cover.jpg"
        />
      </div>
      <div class="t-inj">
        <ProjectTile
          title="N₂O Flow Model (for Injector Sizing)"
          tagline="To better predict oxidizer mass flow rate"
          href="/projects/injector-orifice-sizing"
          image="/assets/projects/flow_model/n2omodel_cover.JPG"
        />
      </div>
      <div class="t-vstand">
        <ProjectTile
          title="Vertical Tank Mount"
          tagline="Ox. tank infrastructure for static fire / cold flow"
          href="/projects/vertical-test-stand"
          image="/assets/projects/tank_mount/tankmount_cover.jpg"
        />
      </div>
      <div class="t-data">
        <ProjectTile
          title="Data Analysis"
          tagline="20+ pages of test reports, Excel Sheets"
          href="/projects/propulsion-data-analysis"
          image="/assets/projects/analysis/analysis_cover.jpg"
        />
      </div>
    </div>

    <div class="section-header">
      <span class="section-label">Mechatronics & Controls Lab</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-uav">
        <ProjectTile
          title="Omnidirectional Thrust-Vectored Quadrotor Research"
          tagline="Overactuated 6-DOF UAV with 4 passive gimbals"
          href="/projects/uav-gimbal-joint"
          image="/assets/projects/maclab/drone_cover.jpg"
        />
      </div>
    </div>

    <div class="section-header">
      <span class="section-label">AdvancingX</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-sub">
        <ProjectTile
          title="EVA Training Submersible"
          tagline="Neutrally buoyant open-frame EVA trainer"
          href="/projects/submersible-v3"
          image="/assets/projects/advancingx/SubX_cover.jpg"
          imagePosition="right 45%"
        />
      </div>
    </div>

    <div class="section-header">
      <span class="section-label">Standalone</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-e1rk">
        <ProjectTile
          title="3D Printed A-Class Rocket"
          tagline="E1RK · FDM sounding rocket — OpenRocket + SolidWorks"
          href="/projects/3d-printed-rocket"
          image="/assets/projects/3dpr/3DPR_cover.JPG"
        />
      </div>
      <div class="t-e1rk">
        <ProjectTile
          title="High Powered G-Class Rocket"
          tagline="E1RK · Fiberglass airframe, 3D-printed nose cone & boat tail"
          href="/projects/group-high-powered-rocket"
          image="/assets/projects/gmpr/gmpr_cover.jpg"
        />
      </div>
      <div class="t-obst">
        <ProjectTile
          title="Autonomous Obstacle Avoidance Vehicle"
          tagline="Ultrasonic Sensing · Arduino IDE · Embedded Systems"
          href="/projects/obstacle-avoidance-robot"
          image="/assets/projects/arduino_car/arduniocar_cover.jpg"
        />
      </div>
      <div class="t-obs">
        <ProjectTile
          title="Observatory Research & Service"
          tagline="Astrometry · Photometry · Education"
          href="/projects/taylor-observatory"
          image="/assets/projects/observatory/foto_cover.jpg"
          imagePosition="top"
        />
      </div>
    </div>

    <div class="section-header">
      <span class="section-label">Reynolds Systems</span>
      <hr class="section-rule" aria-hidden="true" />
    </div>

    <div class="mosaic">
      <div class="t-rs">
        <ITARTile title="Production Tooling Fixtures"       tagline=""   />
      </div>
      <div class="t-rs">
        <ITARTile title="Additive Manufacturing"    tagline=""  />
      </div>
      <div class="t-rs">
        <ITARTile title="Pyrotechnics & Energetics"  tagline=""   />
      </div>
      <div class="t-rs">
        <ITARTile title="Rapid Prototyping" tagline="" />
      </div>
    </div>

  </div>
</Layout>

<script>
  // When preview mode is OFF, disable tiles for pages that aren't ready yet.
  // Tiles become non-interactive — no navigation happens on click.
  const HIDDEN_HREFS = [
    '/projects/obstacle-avoidance-robot',
    '/projects/taylor-observatory',
  ];

  function applyPreviewGating() {
    if (localStorage.getItem('preview') === '1') {
      // Preview ON — restore all tiles to their normal state
      HIDDEN_HREFS.forEach(href => {
        document.querySelectorAll<HTMLElement>(`a.tile[href="${href}"]`).forEach(el => {
          el.style.opacity       = '';
          el.style.pointerEvents = '';
          el.title               = '';
        });
      });
      return;
    }

    // Preview OFF (public mode) — lock incomplete tiles
    HIDDEN_HREFS.forEach(href => {
      document.querySelectorAll<HTMLElement>(`a.tile[href="${href}"]`).forEach(el => {
        el.style.opacity       = '0.35';
        el.style.pointerEvents = 'none';
        el.title               = 'Coming soon';
      });
    });
  }

  document.addEventListener('astro:page-load', applyPreviewGating);

  // Click the big "UCLA Rocket Project" hub to briefly reveal which tiles in
  // the cluster are actually clickable: each one flashes an accent outline,
  // then fades back to normal. Not a toggle; the hub itself never highlights.
  function initRocketHub() {
    const hub = document.querySelector<HTMLElement>('.t-hub .tile');
    if (!hub || hub.dataset.hubInit) return;
    hub.dataset.hubInit = '1';

    const mosaic = hub.closest('.mosaic');
    if (!mosaic) return;
    const subTiles = Array.from(mosaic.querySelectorAll<HTMLElement>('a.tile'));

    hub.setAttribute('role', 'button');
    hub.setAttribute('tabindex', '0');
    hub.setAttribute('aria-label', 'Highlight the clickable Rocket Project case studies');

    function flash() {
      // little press feedback on the hub — no accent ring on itself
      hub.classList.remove('hub-press');
      void hub.offsetWidth; // restart the animation
      hub.classList.add('hub-press');

      subTiles.forEach((tile, i) => {
        tile.classList.remove('rocket-flash');
        void tile.offsetWidth; // restart the animation
        tile.style.setProperty('--flash-delay', `${i * 90}ms`);
        tile.classList.add('rocket-flash');
      });
    }

    // Drop the flash class once each tile's animation ends so nothing stays lit.
    subTiles.forEach(tile => {
      tile.addEventListener('animationend', () => tile.classList.remove('rocket-flash'));
    });

    hub.addEventListener('click', flash);
    hub.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flash(); }
    });
  }

  document.addEventListener('astro:page-load', initRocketHub);
</script>

<style>
  .projects-page { padding-bottom: 4rem; }

  /* Page header — same pattern as About / Skills / Contact */
  .page-header { margin-bottom: 3rem; }

  .page-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--fw-black);
    color: var(--text-100);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .page-header { margin-bottom: 2rem; }
    .page-title  { font-size: clamp(2.5rem, 12vw, 3rem); }
    /* Override the desktop 4rem bottom pad so the last tiles clear the tab bar. */
    .projects-page {
      padding-bottom: calc(var(--mnav-h) + env(safe-area-inset-bottom) + 1.5rem);
    }
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2.5rem 0 1.25rem;
  }
  .section-header:first-child { margin-top: 0; }

  .section-label {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    color: var(--text-35);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    border: none;
    border-top: 1px solid var(--grid-line);
  }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--col-gap);
  }

  /* ── Rocket hub: click to briefly reveal the clickable sub-projects ── */
  .t-hub :global(.tile) { cursor: pointer; }

  /* Subtle press feedback on the hub itself — never an accent ring. */
  .t-hub :global(.tile.hub-press) {
    animation: hubPress 0.4s var(--ease-out);
  }
  @keyframes hubPress {
    0%   { transform: scale(1); }
    35%  { transform: scale(0.985); }
    100% { transform: scale(1); }
  }

  /* Accent outline flashed onto each clickable rocket tile, then fades out.
     Inset ring so it isn't clipped by the tile's overflow:hidden. */
  .mosaic :global(a.tile.rocket-flash)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    box-shadow: inset 0 0 0 2px var(--accent);
    opacity: 0;
    animation: rocketFlash 1s var(--ease-out);
    animation-delay: var(--flash-delay, 0ms);
  }
  @keyframes rocketFlash {
    0%   { opacity: 0; }
    20%  { opacity: 1; }
    55%  { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .t-hub :global(.tile.hub-press) { animation: none; }
  }

  /* Rocket cluster */
  .t-hub    { grid-column: span 7; min-height: 300px; }
  .t-hts    { grid-column: span 5; min-height: 300px; }
  .t-inj    { grid-column: span 4; min-height: 180px; }
  .t-vstand { grid-column: span 4; min-height: 180px; }
  .t-data   { grid-column: span 4; min-height: 180px; }

  /* Reynolds Systems — 4 equal tiles */
  .t-rs { grid-column: span 3; min-height: 200px; }

  /* Single-org sections (AdvancingX, MacLab) — wider tiles */
  .t-sub  { grid-column: span 8; min-height: 260px; }
  .t-uav  { grid-column: span 8; min-height: 260px; }

  /* E1RK — two equal tiles */
  .t-e1rk { grid-column: span 6; min-height: 220px; }

  /* Standalone */
  .t-obst { grid-column: span 6; min-height: 220px; }
  .t-obs  { grid-column: span 6; min-height: 220px; }

  @media (max-width: 900px) {
    .t-hub, .t-hts,
    .t-inj, .t-vstand, .t-data { grid-column: span 6; }
    .t-rs                         { grid-column: span 6; }
    .t-sub, .t-uav               { grid-column: span 10; }
    .t-e1rk, .t-obst, .t-obs    { grid-column: span 6; }
  }

  @media (max-width: 600px) {
    .t-hub, .t-hts,
    .t-inj, .t-vstand, .t-data,
    .t-rs,
    .t-sub, .t-uav,
    .t-e1rk,
    .t-obst, .t-obs { grid-column: span 12; }
  }
</style>
