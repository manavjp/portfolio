---
import ProjectPageLayout from '../../layouts/ProjectPageLayout.astro';
import SpecTable from '../../components/SpecTable.astro';

const specRows = [
  { label: 'Airframe',       value: 'Fiberglass'                        },
  { label: 'Nose Cone',      value: '3D Printed'                        },
  { label: 'Boat Tail',      value: '3D Printed'                        },
  { label: 'Design Tools',   value: 'OpenRocket, SolidWorks'            },
  { label: 'Class',          value: 'E1RK — UCLA'                       },
];
---
<ProjectPageLayout
  title="Group High Powered Rocket"
  description="Fiberglass high-powered rocket with 3D-printed nose cone and boat tail, designed in OpenRocket and SolidWorks for UCLA's E1RK course."
  ghostText="E1RK GMPR"
  category="E1RK — UCLA"
  tagline="Fiberglass airframe, 3D-printed nose cone & boat tail"
>
  <section class="spec-block">
    <SpecTable rows={specRows} title="Specifications" />
    <div class="todo-block">
      <span class="todo-label">TODO — Photos & renders</span>
      <p>Photos of the assembled rocket, SolidWorks renders of nose cone and boat tail, OpenRocket simulation screenshots. Place at <code>public/assets/projects/group-high-powered-rocket/</code>.</p>
    </div>
  </section>

  <section class="the-work">
    <div class="work-row">
      <h2 class="work-label">Overview</h2>
      <div class="work-content">
        <p class="work-text">Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt. Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet.</p>
        <div class="todo-block">
          <span class="todo-label">TODO — Full writeup</span>
          <p>Design process, manufacturing steps, team roles, stability analysis, flight data.</p>
        </div>
      </div>
    </div>
  </section>
</ProjectPageLayout>
