---
import ProjectPageLayout from '../../layouts/ProjectPageLayout.astro';
import SpecTable from '../../components/SpecTable.astro';
import MetricCallout from '../../components/MetricCallout.astro';

const specRows = [
  { label: 'Language',              value: 'Python 3'          },
  { label: 'Thermo. Property Lib.', value: 'CoolProp'          },
  { label: 'N₂O Error (Initial)',   value: '35%'               },
  { label: 'N₂O Error (After)',     value: '10.3%'             },
  { label: 'Orifice Diameter',      value: "0.0468''"          },
  { label: 'Area per Orifice',      value: "0.00172'' ²"       },
  { label: 'Sized Injector To',     value: '69 Orifices'       },
  { label: 'Discharge Coefficient', value: '0.4522'            },
];
---

<ProjectPageLayout
  title="Two-Phase N₂O Flow Model"
  description="Python/CoolProp two-phase model reducing N₂O mass-flow error from 35% to 10.3%."
  ghostText="NITROUS OXIDE"
  category="UCLA Rocket Project"
  tagline="Two-phase N₂O model — 35% → 10.3% mass-flow error"
  showOverview={false}
>
  <!-- Overview + specs alongside rotating injector model (portrait video) -->
  <section class="spec-block" style="grid-template-columns: 1fr 1.2fr; align-items: start; gap: 1.5rem;">
    <div class="spec-col">
      <h2 class="section-overview">Overview</h2>
      <SpecTable rows={specRows} title="Specifications" />
    </div>
    <div class="model-wrap">
      <video
        class="model-video"
        src="/assets/projects/flow_model/injector_model.mp4"
        autoplay loop muted playsinline
        aria-label="Rotating SolidWorks model of the hybrid injector"
      ></video>
    </div>
  </section>

  <section class="metrics-row" aria-label="Key metrics">
    <MetricCallout value="69"    unit="orifices" description="Injector orifices"          />
    <MetricCallout value="10.3"  unit="%"         description="Final N₂O mass-flow error" />
    <MetricCallout value="2.654" unit="lbm/s"     description="Predicted ox flow rate"    />
  </section>

  <section class="the-work">
    <div class="work-row">
      <h2 class="work-label">Problem</h2>
      <div class="work-content">
        <!-- FILL IN - Problem: Describe the engineering challenge that motivated this project -->
      </div>
    </div>
    <div class="work-row">
      <h2 class="work-label">Approach</h2>
      <div class="work-content">
        <!-- FILL IN - Approach: Explain the methodology, key decisions, and tools used -->
      </div>
    </div>
    <div class="work-row">
      <h2 class="work-label">Analysis</h2>
      <div class="work-content">
        <!-- Calibration curves — ~16:10 landscape chart -->
        <figure class="proj-figure">
          <img src="/assets/projects/flow_model/calibration_curves_at_best_kappa.png"
               alt="SPI vs HEM calibration curves at best kappa — mass-flow comparison" loading="lazy" />
          <figcaption>Shows the SPI model substantially overpredicts mass flow relative to the clamped HEM behavior, with the measured flow rate landing below the HEM critical limit</figcaption>
        </figure>
        <!-- Iteration results — ~16:9 landscape chart -->
        <figure class="proj-figure">
          <img src="/assets/projects/flow_model/iteration_results.png"
               alt="Orifice count sweep optimization results" loading="lazy" />
          <figcaption>The optimization works by sweeping the number of orifices, comparing the predicted mass flow against the target, and selecting the recommended count of 69 where the design-point curve intersects the target</figcaption>
        </figure>
      </div>
    </div>
    <div class="work-row">
      <h2 class="work-label">Result</h2>
      <div class="work-content">
        <!-- FILL IN - Result: Describe what was achieved — metrics, validation, outcomes -->
      </div>
    </div>
    <div class="work-row">
      <h2 class="work-label">Reflection</h2>
      <div class="work-content">
        <!-- FILL IN - Reflection: Lessons learned and what would be done differently -->
      </div>
    </div>
  </section>
</ProjectPageLayout>

<style>
  /* Portrait model wrap — injector_model.mp4 is 9:16, shown at 3:4 crop */
  .model-wrap {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bg);
  }
  .model-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .spec-col {
    display: flex;
    flex-direction: column;
  }
  .spec-col :global(.section-overview) {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: var(--fw-black);
    color: var(--text-100);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
</style>
