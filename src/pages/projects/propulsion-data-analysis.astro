---
import ProjectPageLayout from '../../layouts/ProjectPageLayout.astro';
import SpecTable from '../../components/SpecTable.astro';
import MetricCallout from '../../components/MetricCallout.astro';
import ThrustChart from '../../components/ThrustChart.astro';
import PdfViewer from '../../components/PdfViewer.astro';
import ScatteredReports from '../../components/ScatteredReports.astro';

const specRows = [
  { label: 'Test Campaigns', value: '15 (Hydro, Cold Flow, Static Fire)'                     },
  { label: 'Test Reports',   value: '20+ pages'                                               },
  { label: 'Instruments',    value: 'Load Cell · Pressure Transducer · Gauge · Video · Audio' },
  { label: 'Software',       value: 'Microsoft Excel · Python 3 · Matplotlib · Plotly'        },
];

/**
 * Reports — set href to the Google Drive share link when ready.
 * image: first-page thumbnails extracted from PDFs (PyMuPDF @ 150 dpi).
 */
const reports = [
  {
    title:    'Cold Flow — 001',
    subtitle: 'Injector cold-flow characterization',
    date:     '2026',
    href:     'https://drive.google.com/file/d/16FsHAieUCGg0NhS79kpLV1hK8QHQs-hb/view?usp=sharing',  // TODO: replace with Google Drive link
    image:    '/assets/projects/analysis/cold_flow_cover.jpg',
  },
  {
    title:    'Hydrostatic — 003',
    subtitle: 'Tank pressure validation',
    date:     '2026',
    href:     'https://drive.google.com/file/d/1T9eHZm6w2rG5v9pwIlipGpiOyN7-8j56/view?usp=sharing',  // TODO: replace with Google Drive link
    image:    '/assets/projects/analysis/hydrostatic_cover.jpg',
  },
];
---
<ProjectPageLayout
  title="Propulsion Test &amp; Analysis"
  description="20+ pages of hydro, cold-flow, and static-fire test reports across fifteen UCLA Rocket Project test campaigns."
  ghostText="ANALYSIS"
  category="UCLA Rocket Project"
  tagline="20+ pages of hydro, cold-flow &amp; static-fire test reports"
  nextHref="/projects/uav-gimbal-joint"
>
  <!-- Spec table left, scattered report card deck right (original format) -->
  <section class="spec-block spec-block--reports">
    <SpecTable rows={specRows} title="Specifications" />
    <div class="reports-col">
      <ScatteredReports reports={reports} />
    </div>
  </section>

  <section class="metrics-row" aria-label="Key metrics">
    <MetricCallout value="50"  unit="+"  description="Injector water flows"        />
    <MetricCallout value="15"  unit="+"  description="Hydrostatic pressure cycles" />
    <MetricCallout value="100" unit="+"  description="Bubble leak checks"          />
  </section>

  <section class="the-work">
    <div class="work-row">
      <h2 class="work-label">Problem</h2>
      <div class="work-content">
        <!-- FILL IN - Problem: Describe the engineering challenge that motivated this project -->
      </div>
    </div>
    <div class="work-row">
      <h2 class="work-label">Approach</h2>
      <div class="work-content">
        <!-- FILL IN - Approach: Explain the methodology, key decisions, and tools used -->
      </div>
    </div>
    <div class="work-row">
      <h2 class="work-label">Analysis</h2>
      <div class="work-content">
        <ThrustChart />
        <!-- Injector Waterflow Analysis — 3-page PDF, arrow-navigable -->
        <PdfViewer
          src="/assets/projects/analysis/_Particularity_ Injector Waterflow Analysis - Google Sheets.pdf"
          pages={3}
          label="Injector Waterflow Analysis"
          aspectRatio="2 / 1"
        />
      </div>
    </div>
    <div class="work-row">
      <h2 class="work-label">Result</h2>
      <div class="work-content">
        <!-- FILL IN - Result: Describe what was achieved — metrics, validation, outcomes -->
        <!-- CO2 cold flow with data overlay — landscape 16:9 -->
        <figure class="proj-figure">
          <video class="result-video" autoplay loop muted playsinline
                 aria-label="Data overlay on CO2 cold flow test">
            <source src="/assets/projects/analysis/cold_flow_slow.mp4" type="video/mp4" />
          </video>
          <figcaption>Data overlay on CO₂ Cold Flow test</figcaption>
        </figure>
      </div>
    </div>
    <div class="work-row">
      <h2 class="work-label">Reflection</h2>
      <div class="work-content">
        <!-- FILL IN - Reflection: Lessons learned and what would be done differently -->
      </div>
    </div>
  </section>
</ProjectPageLayout>

<style>
  /* ── Spec + scattered reports ───────────────────────── */
  .spec-block--reports {
    display: flex;
    gap: 5rem;
    align-items: start;
    flex-wrap: wrap;
    margin-bottom: 4rem;
    overflow: visible;
  }
  .spec-block--reports > :global(.spec-table-wrap) { flex: 1 1 260px; }
  .reports-col {
    flex: 1;
    overflow: visible;
  }

  /* ── Result video ───────────────────────────────────── */
  .result-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    object-fit: cover;
  }
</style>
