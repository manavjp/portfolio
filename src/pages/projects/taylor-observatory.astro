---
import ProjectPageLayout from '../../layouts/ProjectPageLayout.astro';
import SpecTable from '../../components/SpecTable.astro';

const specRows = [
  { label: 'Telescope',    value: 'RASA (Rowe-Ackermann Schmidt Astrograph)' },
  { label: 'Submissions',  value: 'IAU Minor Planet Center'                   },
  { label: 'Data Types',   value: 'Astrometry, photometry'                    },
  { label: 'Programs',     value: 'Planetarium, public astronomy'             },
];
---
<ProjectPageLayout
  title="Observatory Research & Service"
  description="Astrometric and photometric data submitted to the IAU Minor Planet Center, RASA telescope commissioning, and education programs."
  ghostText="OBSERVATORY"
  category="Taylor Observatory"
  tagline="Astrometry · Photometry · Education"
  nextHref="/projects/horizontal-propulsion-test-stand"
>
  <section class="spec-block">
    <SpecTable rows={specRows} title="Details" />
    <figure class="proj-figure">
      <img src="/assets/projects/observatory/dome_night.jpg"
           alt="Taylor Observatory dome at night under the stars" loading="lazy" />
      <figcaption>Taylor Observatory — dome at night</figcaption>
    </figure>
  </section>

  <section class="obs-body">
    <!-- FILL IN - General: section text -->
    <figure class="proj-figure obs-figure--wide">
      <img src="/assets/projects/observatory/foto_cover.jpg"
           alt="Telescope pointed at a star field for astrometric data collection" loading="lazy" />
      <figcaption>Astrometric observation session</figcaption>
    </figure>
  </section>
</ProjectPageLayout>

<style>
  .obs-body { margin-top: 2rem; max-width: 72ch; display: flex; flex-direction: column; gap: 1.5rem; }
  .obs-figure--wide { max-width: 100%; }
</style>
